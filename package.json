{
  "name": "coachlab",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @coachlab/web dev",
    "build": "pnpm --filter @coachlab/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:push": "supabase db push",
    "gen:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > packages/core/src/types/database.ts",
    "dump:openapi": "tsx scripts/dump-openapi.ts",
    "seed": "tsx scripts/seed.ts",
    "verify:setup": "node scripts/verify-setup.mjs",
    "set:password": "node scripts/set-password.mjs",
    "smoke:player": "tsx scripts/smoke-player.ts"
  },
  "devDependencies": {
    "@coachlab/api": "workspace:*",
    "@coachlab/core": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.0",
    "supabase": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
